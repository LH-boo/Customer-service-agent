# ==========================================================
# 医院客服工单 Agent —— 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交
# ==========================================================

# ---------- 应用 ----------
APP_NAME=仁心医院患者服务工单 Agent
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ---------- 鉴权（生产环境务必替换为随机长字符串）----------
JWT_SECRET=please-change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- 大模型（兼容 OpenAI 协议的任意服务）----------
# 留空则运行在「规则 + 检索式回答」的离线演示模式
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# Embedding（RAG 向量检索使用，可单独配置服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- 数据库（默认 SQLite，开箱即用；生产切 MySQL）----------
DATABASE_URL=sqlite+aiosqlite:///./data/hospital.db
# DATABASE_URL=mysql+aiomysql://hospital:hospital123@127.0.0.1:3306/hospital?charset=utf8mb4

# ---------- Redis（不启动时自动降级为进程内缓存）----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
FAQ_CACHE_TTL=604800
SESSION_TTL=7200
TICKET_CACHE_TTL=60

# ---------- RAG ----------
KNOWLEDGE_DIR=./data/knowledge
RAG_TOP_K=5
RAG_CANDIDATE_K=12
RAG_MIN_SCORE=0.18

# Milvus（可选，未配置时仅使用 BM25 检索）
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=hospital_knowledge

# Elasticsearch（可选，未配置时使用本地 BM25 索引）
ES_URL=
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=hospital_knowledge

# Reranker（可选 HTTP 服务，如 bge-reranker；未配置时跳过重排）
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- MCP ----------
# local：进程内直接调用业务服务（默认，启动最快）
# client：通过 stdio 连接独立 MCP Server 进程，完整演示 MCP 调用链路
MCP_MODE=local
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m app.mcp.server
MCP_TIMEOUT_SECONDS=30

# ---------- 业务规则 ----------
# 预约取消需提前的小时数（演示规则）
CANCEL_MIN_HOURS=2
# 费用争议自动转人工的金额阈值（元）
FEE_DISPUTE_AMOUNT=300
